# Non-secret image references only. Copy to configs/platform-images.env.
# Replace YOUR_DOCKERHUB_ACCOUNT and example tags with images you actually publish.
# The file renderer rejects missing tokens, whitespace and :latest.
ICEBERG_REST_IMAGE=docker.io/YOUR_DOCKERHUB_ACCOUNT/iceberg-rest:iceberg-1.11.0-v1
SPARK_IMAGE=docker.io/YOUR_DOCKERHUB_ACCOUNT/spark:spark-4.1.2-iceberg-1.11.0-v1
ARTICLE_COLLECTOR_IMAGE=docker.io/YOUR_DOCKERHUB_ACCOUNT/article-collector:v1
BRONZE_TO_SILVER_IMAGE=docker.io/YOUR_DOCKERHUB_ACCOUNT/article-bronze-to-silver:v1
SILVER_TO_GOLD_IMAGE=docker.io/YOUR_DOCKERHUB_ACCOUNT/article-silver-to-gold:v1
GOLD_PUBLISHER_IMAGE=docker.io/YOUR_DOCKERHUB_ACCOUNT/article-gold-publisher:v1
KAFKA_CONNECT_IMAGE=docker.io/YOUR_DOCKERHUB_ACCOUNT/kafka-connect-neo4j:v1
AIRFLOW_IMAGE=docker.io/YOUR_DOCKERHUB_ACCOUNT/airflow:3.0.2-kubernetes-10.24.0
